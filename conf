#!/bin/sh -e
# Build time configuration of the Redis component, run by fab inside the
# chroot after the overlay is applied (share/product.mk, "run the unit
# configuration scripts"). It runs once per image: a layer built on a parent
# that already carries this unit does not run it again, which is what
# bt-layer's units field in the layer manifest is for.
#
# Three things happen here and nothing else.
#
#   1. Debian's /etc/redis/redis.conf is given one appended line: an include
#      of the fragment directory this component's overlay ships. Redis keeps
#      the last value it read for a directive, and Redis's own manual says
#      to put an include last when the included file is meant to override,
#      so the fragments win and the packaged conffile keeps all 110 kB of
#      its comments and every other default untouched. One appended line is
#      also the smallest conffile change an upgrade can be asked to merge.
#
#   2. The fragments the overlay must have delivered are checked to be
#      there, because an include of an empty directory is not an error in
#      Redis: a glob that matches nothing is read as nothing, and a silently
#      unconfigured server would start and answer on Debian's defaults.
#
#   3. The server is started against that very file and asked what it is
#      doing. Asserting the configuration is not asserting the behaviour
#      (docs/traps.md): the PostgreSQL appliance shipped listening on IPv4
#      only with a listen_addresses that read correctly, and its own build
#      had checked the file it wrote. So this asks the running server on
#      [::1] and on 127.0.0.1 in turn, and asks it for a key it must refuse.
#
# The check leaves nothing in the image, and that took two goes. --dir and
# --logfile point at a scratch directory that is removed afterwards, and
# --save '' means the server has no snapshot points at all, so no dump.rdb
# is ever written. What --logfile does not prevent is the packaged log file
# being created: Redis opens every value its logfile setting is ever given,
# and the packaged configuration gives one before the command line replaces
# it. The check runs as root, so that opening leaves
# /var/log/redis/redis-server.log owned by root in a directory the redis
# user owns, and the service then cannot start on the machine at all:
#
#     redis-server[524]: *** FATAL CONFIG FILE ERROR (Redis 8.0.2) ***
#     redis-server[524]: Can't open the log file: Permission denied
#
# Measured on the booted appliance of the first build that got that far.
# The package ships no such file; redis creates it at its first start, as
# its own user. So the check takes an empty one away again.
#
# The paths and the port below are overridable defaults, so the script can
# be run against scratch directories and measured (decision 0004). Nothing
# sets them in a build.

REDIS_CONF="${REDIS_CONF:-/etc/redis/redis.conf}"
REDIS_CONF_D="${REDIS_CONF_D:-/etc/redis/redis.conf.d}"
REDIS_CHECK_DIR="${REDIS_CHECK_DIR:-/tmp/keel-redis-conf-check}"
REDIS_CHECK_HOSTS="${REDIS_CHECK_HOSTS:-::1 127.0.0.1}"
REDIS_PORT="${REDIS_PORT:-6379}"
REDIS_TRIES="${REDIS_TRIES:-30}"

fatal() {
    echo "FATAL [unit-redis conf]: $*" >&2
    # The server's own log, when there is one, because the check below
    # removes the directory it is in and a build that failed for want of a
    # log is a build nobody can diagnose. The first build of this component
    # failed exactly that way.
    if [ -s "$REDIS_CHECK_DIR/redis.log" ]; then
        echo "FATAL [unit-redis conf]: the last lines of the server's own log:" >&2
        tail -n 20 "$REDIS_CHECK_DIR/redis.log" >&2
    fi
    exit 1
}

# redis_port_line HOST: the tcp_port line the server at HOST reports, with
# the carriage returns taken out, and nothing when it reports none.
#
# The tr is the whole point of this function. Redis speaks CRLF: every line
# of an INFO reply ends "\r\n", and redis-cli prints the reply as it came,
# so "tcp_port:6379" is really "tcp_port:6379\r" and a grep anchored with a
# dollar never matches it. The first build of this component failed there,
# with a server that was up and listening on both families and a check that
# said no Redis answered. Measured in the chroot of that build:
#
#     redis-cli INFO server | grep tcp_port | od -c
#     t c p _ p o r t : 6 3 7 9 \r \n
#
# Anything that reads an INFO reply has to do this, or match a prefix and
# never a whole line.
redis_port_line() {
    redis-cli -h "$1" -p "$REDIS_PORT" INFO server 2>/dev/null \
        | tr -d '\r' | grep -x "tcp_port:$REDIS_PORT"
}

# 1. The fragments. They come from the overlay, which fab applied before
#    this script ran, so their absence means the overlay did not arrive.
[ -d "$REDIS_CONF_D" ] || fatal "$REDIS_CONF_D is not in the tree: the component overlay did not arrive"
for fragment in 10-keel-bind.conf 20-keel-acl.conf; do
    [ -f "$REDIS_CONF_D/$fragment" ] \
        || fatal "$REDIS_CONF_D/$fragment is missing: the component overlay is incomplete"
done
[ -f "$REDIS_CONF" ] || fatal "$REDIS_CONF is not in the tree: redis-server is not installed"

# 2. The include, appended once and last. grep -F because the line holds a
#    glob, and -x so a commented example of the same text does not count.
include_line="include $REDIS_CONF_D/*.conf"
if ! grep -qxF "$include_line" "$REDIS_CONF"; then
    cat >> "$REDIS_CONF" <<APPEND

# Keel: the fragments of $REDIS_CONF_D, read here, at the end of
# the file, because Redis keeps the last value it read for a directive.
$include_line
APPEND
fi
[ "$(tail -n 1 "$REDIS_CONF")" = "$include_line" ] \
    || fatal "$REDIS_CONF does not end with '$include_line', so a fragment would not win"

# 3. The running server. It is started from the real configuration file, so
#    what is proved below is what an appliance built on this component gets.
#
#    The packaged log file is read out of that configuration first, so that
#    stop_server can take it away again: see the note at the top.
packaged_log=$(sed -n 's/^logfile[[:space:]][[:space:]]*//p' "$REDIS_CONF" | tail -1)
mkdir -p "$REDIS_CHECK_DIR"
redis-server "$REDIS_CONF" \
    --daemonize yes \
    --dir "$REDIS_CHECK_DIR" \
    --logfile "$REDIS_CHECK_DIR/redis.log" \
    --pidfile "$REDIS_CHECK_DIR/redis.pid" \
    --save '' \
    || fatal "redis-server refused $REDIS_CONF"

stop_server() {
    # SHUTDOWN is not a command the default user may run, which is the whole
    # point of 20-keel-acl.conf, so the check stops the server the way init
    # would: the pid it was told to write.
    if [ -s "$REDIS_CHECK_DIR/redis.pid" ]; then
        kill "$(cat "$REDIS_CHECK_DIR/redis.pid")" 2>/dev/null || true
    fi
    rm -rf "$REDIS_CHECK_DIR"
    # And the packaged log file, if running the server here created it and
    # nothing was written to it. Empty, so nothing is lost; owned by root
    # in a directory the redis user owns, so leaving it is a service that
    # cannot start. Whoever created it, an empty log file in an image is
    # worth nothing: redis makes its own at the first boot.
    if [ -n "$packaged_log" ] && [ -f "$packaged_log" ] && [ ! -s "$packaged_log" ]; then
        rm -f "$packaged_log"
    fi
}
trap stop_server EXIT INT TERM

attempt=1
while [ "$attempt" -le "$REDIS_TRIES" ]; do
    redis_port_line ::1 > /dev/null && break
    attempt=$((attempt + 1))
    sleep 1
done

# Both loopback families answer, each asked at its own literal address. This
# is the assertion the bind fragment exists for, and it is made against the
# server rather than against the line that was written.
#
# INFO is the question because it is the only one the default user may ask
# after 20-keel-acl.conf, and because it is exactly what `keel inspect` runs
# to read this machine's database.server.role.
for host in $REDIS_CHECK_HOSTS; do
    redis_port_line "$host" > /dev/null \
        || fatal "no Redis reported tcp_port:$REDIS_PORT on [$host]:$REDIS_PORT," \
            "after $REDIS_TRIES tries on [::1]"
done

# And the other half of 20-keel-acl.conf: a client with no secret is refused
# every key. The answer is read rather than the exit code, because redis-cli
# exits 0 when the server replies with an error.
refusal=$(redis-cli -h ::1 -p "$REDIS_PORT" GET keel:no-such-key 2>&1 || true)
case "$refusal" in
    NOPERM*)
        echo "[unit-redis conf] Redis answers INFO on [::1]:$REDIS_PORT and on"
        echo "[unit-redis conf] [127.0.0.1]:$REDIS_PORT, and refuses every key"
        echo "[unit-redis conf] to a client with no secret"
        ;;
    *) fatal "an unauthenticated client was answered '$refusal' for GET, not NOPERM" ;;
esac
